<odoo>
    <!-- Trial Onboarding Guide content is authored by a later ticket (#122); this is the
         stable static path it will publish to (custom_addons/hosting/static/docs/), reached
         the same unauthenticated way crm_methodology's teach docs are (ADR-0007). Declared
         before the form view below so the button's %(...)d reference resolves. -->
    <record id="action_hosting_getting_started" model="ir.actions.act_url">
        <field name="name">Getting Started</field>
        <field name="url">/hosting/static/docs/index.html</field>
        <field name="target">new</field>
    </record>

    <record id="view_hosting_org_registration_list" model="ir.ui.view">
        <field name="name">hosting.org.registration.list</field>
        <field name="model">hosting.org.registration</field>
        <field name="arch" type="xml">
            <list string="Org Registration" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="prospect_domain"/>
                <field name="seats_used"/>
                <field name="seat_cap"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <record id="view_hosting_org_registration_form" model="ir.ui.view">
        <field name="name">hosting.org.registration.form</field>
        <field name="model">hosting.org.registration</field>
        <field name="arch" type="xml">
            <form string="Org Registration" create="0" edit="0" delete="0">
                <header>
                    <!-- Permanent way back to the onboarding content after the first-login
                         prompt (#121) has been dismissed - same destination, per #122. -->
                    <button type="action" name="%(hosting.action_hosting_getting_started)d"
                            string="Getting Started" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="prospect_domain"/>
                        <field name="seats_used"/>
                        <field name="seat_cap"/>
                        <field name="expiry_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hosting_org_registration" model="ir.actions.act_window">
        <field name="name">Org Registration</field>
        <field name="res_model">hosting.org.registration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
