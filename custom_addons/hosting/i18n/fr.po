#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"This is a quick orientation to how your trial works - not a product tour.\n"
"                Here's what to know before you dive in."
msgstr "Voici une orientation rapide sur le fonctionnement de votre essai - pas une visite du produit. Voici ce qu'il faut savoir avant de commencer."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/js/expiry_countdown_systray.js:0
