#: model:ir.model,name:hosting.model_res_users
msgid "User"
msgstr "Пользователь"

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid "View the full Getting Started guide"
msgstr "Посмотреть полное руководство по началу работы"

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid "Welcome to your trial"
msgstr "Добро пожаловать в вашу пробную версию"

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"You can invite teammates yourself, up to the seat cap - no need to\n"
"                            route it through factory1."
msgstr "Вы можете самостоятельно приглашать коллег по команде, вплоть до лимита мест - без необходимости обращаться в factory1."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial expires on a set date, shown in the systray up top. Ask\n"
"                            your sales contact for an extension before it lapses."
msgstr "Срок действия вашей пробной версии истекает в фиксированную дату, показанную вверху в системном трее. Попросите своего менеджера по продажам продлить её до истечения срока."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial has a fixed seat cap. Once a teammate joins, they take\n"
"                            one of those seats."
msgstr "У вашей пробной версии фиксированный лимит мест. Как только коллега присоединяется, он занимает одно из этих мест."
