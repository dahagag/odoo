msgstr "Visualizza la guida completa per iniziare"

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid "Welcome to your trial"
msgstr "Benvenuto nella tua prova"

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"You can invite teammates yourself, up to the seat cap - no need to\n"
"                            route it through factory1."
msgstr "Puoi invitare tu stesso i compagni di squadra, fino al limite di posti - senza doverlo far passare da factory1."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial expires on a set date, shown in the systray up top. Ask\n"
"                            your sales contact for an extension before it lapses."
msgstr "La tua prova scade a una data fissa, mostrata in alto nella barra di sistema. Chiedi al tuo contatto commerciale un'estensione prima che scada."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial has a fixed seat cap. Once a teammate joins, they take\n"
"                            one of those seats."
msgstr "La tua prova ha un limite di posti fisso. Non appena un compagno di squadra si unisce, occupa uno di quei posti."
