#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid "Welcome to your trial"
msgstr "Welkom bij uw proefversie"

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"You can invite teammates yourself, up to the seat cap - no need to\n"
"                            route it through factory1."
msgstr "U kunt zelf teamgenoten uitnodigen, tot de zetellimiet - zonder dat dit via factory1 hoeft te lopen."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial expires on a set date, shown in the systray up top. Ask\n"
"                            your sales contact for an extension before it lapses."
msgstr "Uw proefversie verloopt op een vaste datum, weergegeven bovenaan in het systeemvak. Vraag uw verkoopcontact om verlenging voordat deze verloopt."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial has a fixed seat cap. Once a teammate joins, they take\n"
"                            one of those seats."
msgstr "Uw proefversie heeft een vaste zetellimiet. Zodra een teamgenoot zich aansluit, neemt deze een van die zetels in."
