#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"You can invite teammates yourself, up to the seat cap - no need to\n"
"                            route it through factory1."
msgstr "Você pode convidar colegas de equipe você mesmo, até o limite de vagas - sem precisar passar pela factory1."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial expires on a set date, shown in the systray up top. Ask\n"
"                            your sales contact for an extension before it lapses."
msgstr "Seu teste expira em uma data fixa, mostrada no topo na bandeja do sistema. Peça ao seu contato de vendas uma extensão antes que expire."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial has a fixed seat cap. Once a teammate joins, they take\n"
"                            one of those seats."
msgstr "Seu teste tem um limite de vagas fixo. Assim que um colega de equipe entra, ele ocupa uma dessas vagas."
