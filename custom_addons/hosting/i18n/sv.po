#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid "Welcome to your trial"
msgstr "Välkommen till din provperiod"

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"You can invite teammates yourself, up to the seat cap - no need to\n"
"                            route it through factory1."
msgstr "Du kan bjuda in lagkamrater själv, upp till platsgränsen - utan att behöva gå via factory1."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial expires on a set date, shown in the systray up top. Ask\n"
"                            your sales contact for an extension before it lapses."
msgstr "Din provperiod löper ut på ett fast datum, som visas högst upp i systemfältet. Be din säljkontakt om en förlängning innan den löper ut."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial has a fixed seat cap. Once a teammate joins, they take\n"
"                            one of those seats."
msgstr "Din provperiod har en fast platsgräns. Så snart en lagkamrat ansluter tar de en av dessa platser."
