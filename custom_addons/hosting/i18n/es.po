msgstr "Ver la guía completa de primeros pasos"

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid "Welcome to your trial"
msgstr "Bienvenido a su prueba"

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"You can invite teammates yourself, up to the seat cap - no need to\n"
"                            route it through factory1."
msgstr "Puede invitar a compañeros de equipo usted mismo, hasta el límite de asientos - sin necesidad de pasar por factory1."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial expires on a set date, shown in the systray up top. Ask\n"
"                            your sales contact for an extension before it lapses."
msgstr "Su prueba vence en una fecha fija, que se muestra arriba en la bandeja del sistema. Pida a su contacto de ventas una extensión antes de que venza."

#. module: hosting
#. odoo-javascript
#: code:addons/hosting/static/src/xml/onboarding_prompt.xml:0
msgid ""
"Your trial has a fixed seat cap. Once a teammate joins, they take\n"
"                            one of those seats."
msgstr "Su prueba tiene un límite de asientos fijo. En cuanto se une un compañero de equipo, ocupa uno de esos asientos."
