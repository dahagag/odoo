<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_methodology_playbook_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.methodology.playbook.wizard.form</field>
        <field name="model">crm.methodology.playbook.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="activity_id" invisible="1"/>
                <p>
                    Suggested questions for this <field name="activity_type_name" nolabel="1" readonly="1"/>:
                </p>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="question" readonly="1"/>
                        <field name="answer"/>
                    </list>
                </field>
                <field name="feedback" placeholder="Any other notes about this activity..."/>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button name="action_skip" type="object" string="Skip Playbook" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
