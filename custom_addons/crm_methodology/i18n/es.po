#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org extended by %(days)s days, new expiry %(expiry)s."
msgstr "Trial Org extendido %(days)s días, nuevo vencimiento %(expiry)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via a Targeted Invite to %(email)s."
msgstr "Trial Org emitido mediante una Invitación Dirigida a %(email)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via an Open Invite Link for %(domain)s."
msgstr ""
"Trial Org emitido mediante un Enlace de Invitación Abierto para %(domain)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "expired"
msgstr "vencido"

