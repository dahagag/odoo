msgstr "Trial Org %(days)s gün uzatıldı, yeni son kullanma tarihi %(expiry)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via a Targeted Invite to %(email)s."
msgstr "Trial Org, Hedefli Davet yoluyla %(email)s adresine verildi."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via an Open Invite Link for %(domain)s."
msgstr "Trial Org, %(domain)s için Açık Davet Bağlantısı yoluyla verildi."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "expired"
msgstr "süresi doldu"

