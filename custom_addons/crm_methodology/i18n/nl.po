#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org extended by %(days)s days, new expiry %(expiry)s."
msgstr "Trial Org met %(days)s dagen verlengd, nieuwe vervaldatum %(expiry)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via a Targeted Invite to %(email)s."
msgstr "Trial Org uitgegeven via een Gerichte Uitnodiging aan %(email)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via an Open Invite Link for %(domain)s."
msgstr "Trial Org uitgegeven via een Open Uitnodigingslink voor %(domain)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "expired"
msgstr "verlopen"

