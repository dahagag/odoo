#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org extended by %(days)s days, new expiry %(expiry)s."
msgstr "Trial Org förlängd med %(days)s dagar, nytt utgångsdatum %(expiry)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via a Targeted Invite to %(email)s."
msgstr "Trial Org utfärdad via en Riktad Inbjudan till %(email)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via an Open Invite Link for %(domain)s."
msgstr "Trial Org utfärdad via en Öppen Inbjudningslänk för %(domain)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "expired"
msgstr "utgången"

