#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org extended by %(days)s days, new expiry %(expiry)s."
msgstr "Trial Org prolongé de %(days)s jours, nouvelle expiration %(expiry)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via a Targeted Invite to %(email)s."
msgstr "Trial Org émis via une Invitation Ciblée à %(email)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via an Open Invite Link for %(domain)s."
msgstr "Trial Org émis via un Lien d'Invitation Ouvert pour %(domain)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "expired"
msgstr "expiré"

