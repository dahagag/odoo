#: code:addons/crm_methodology/models/crm_lead.py:0
msgid ""
"%(date)s <strong>%(countdown)s</strong> + %(retention_days)s days of data "
"retention"
msgstr ""
"%(date)s <strong>%(countdown)s</strong> + %(retention_days)s giorni di "
"conservazione dei dati"

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "%(duration)s left"
msgstr "%(duration)s rimanente"

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "A Targeted Invite needs a specific email address."
msgstr "Un Invito Mirato richiede un indirizzo e-mail specifico."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "A Trial Org has already been issued for this opportunity."
msgstr "Per questa opportunità è già stato emesso un Trial Org."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "A prospect domain is required to issue a Trial Org."
msgstr "Per emettere un Trial Org è necessario un dominio del prospect."

#. module: crm_methodology
#: model:ir.model.fields,field_description:crm_methodology.field_crm_methodology_trial_extend_wizard__additional_days
msgid "Additional Days"
msgstr "Giorni aggiuntivi"

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Additional days must be a positive whole number."
msgstr "I giorni aggiuntivi devono essere un numero intero positivo."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "An Open Invite Link doesn't take a specific email address."
msgstr "Un Link di Invito Aperto non accetta un indirizzo e-mail specifico."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/wizards/crm_methodology_trial_wizard.py:0
msgid "Enter the specific email address for a Targeted Invite."
msgstr "Inserisci l'indirizzo e-mail specifico per un Invito Mirato."

#. module: crm_methodology
#: model:ir.actions.act_window,name:crm_methodology.crm_methodology_trial_extend_wizard_action
#: model_terms:ir.ui.view,arch_db:crm_methodology.crm_lead_view_form_methodology
#: model_terms:ir.ui.view,arch_db:crm_methodology.crm_methodology_trial_extend_wizard_view_form
msgid "Extend Trial"
msgstr "Estendi prova"

#. module: crm_methodology
#: model:ir.model,name:crm_methodology.model_crm_methodology_trial_extend_wizard
msgid "Extend Trial Org"
msgstr "Estendi Trial Org"

#. module: crm_methodology
#: model:ir.model.fields,field_description:crm_methodology.field_crm_methodology_trial_issue_wizard__invite_email
msgid "Invite Email"
msgstr "E-mail di invito"

#. module: crm_methodology
#: model:ir.model.fields,field_description:crm_methodology.field_crm_methodology_trial_issue_wizard__invite_type
msgid "Invite Type"
msgstr "Tipo di invito"

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Invite type must be either a Targeted Invite or an Open Invite Link."
msgstr ""
"Il tipo di invito deve essere un Invito Mirato o un Link di Invito Aperto."

#. module: crm_methodology
#: model:ir.actions.act_window,name:crm_methodology.crm_methodology_trial_issue_wizard_action
#: model_terms:ir.ui.view,arch_db:crm_methodology.crm_lead_view_form_methodology
#: model_terms:ir.ui.view,arch_db:crm_methodology.crm_methodology_trial_issue_wizard_view_form
msgid "Issue Trial"
msgstr "Emetti prova"

#. module: crm_methodology
#: model:ir.model,name:crm_methodology.model_crm_methodology_trial_issue_wizard
msgid "Issue Trial Org"
msgstr "Emetti Trial Org"

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "No Trial Org has been issued for this opportunity yet."
msgstr "Per questa opportunità non è ancora stato emesso alcun Trial Org."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Only Salespeople can issue a Trial Org."
msgstr "Solo i Venditori possono emettere un Trial Org."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid ""
"Only this Opportunity's owner or a Sales Manager can extend its Trial Org."
msgstr ""
"Solo il proprietario di questa Opportunità o un Sales Manager può estendere "
"il suo Trial Org."

#. module: crm_methodology
#: model:ir.model.fields.selection,name:crm_methodology.selection__crm_methodology_trial_issue_wizard__invite_type__open
msgid "Open Invite Link"
msgstr "Link di Invito Aperto"

#. module: crm_methodology
#: model:ir.model.fields,field_description:crm_methodology.field_crm_methodology_trial_issue_wizard__prospect_domain
msgid "Prospect Domain"
msgstr "Dominio del prospect"

#. module: crm_methodology
#: model:ir.model.fields,field_description:crm_methodology.field_crm_methodology_trial_issue_wizard__seat_cap
msgid "Seat Cap"
msgstr "Limite posti"

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Seat count must be a positive whole number."
msgstr "Il numero di posti deve essere un numero intero positivo."

#. module: crm_methodology
#: model:ir.model.fields.selection,name:crm_methodology.selection__crm_methodology_trial_issue_wizard__invite_type__targeted
msgid "Targeted Invite"
msgstr "Invito Mirato"

#. module: crm_methodology
#: model:ir.model.fields,help:crm_methodology.field_crm_lead__trial_org_id
msgid "The Trial Org issued for this opportunity's prospect, if any."
msgstr ""
"Il Trial Org emesso per il prospect di questa opportunità, se presente."

#. module: crm_methodology
#: model:ir.model.fields,help:crm_methodology.field_crm_lead__trial_expiry_display
msgid ""
"The Trial Org's expiry date, formatted per the viewing user's own language, "
"with the countdown to Auto-Destroy and the post-Auto-Destroy data retention "
"window alongside it. The retention figure reflects the policy documented in "
"docs/contexts/hosting/CONTEXT.md's Auto-Destroy entry - hosting_admin does "
"not yet automate that snapshot/retention itself, so this is informational, "
"not a tracked system guarantee."
msgstr ""
"La data di scadenza del Trial Org, formattata secondo la lingua dell'utente "
"che la visualizza, insieme al conto alla rovescia fino all'Auto-Destroy e "
"alla finestra di conservazione dei dati successiva all'Auto-Destroy. La "
"cifra di conservazione riflette la politica documentata nella voce Auto-"
"Destroy di docs/contexts/hosting/CONTEXT.md - hosting_admin non automatizza "
"ancora questo snapshot/questa conservazione, quindi si tratta di "
"un'informazione, non di una garanzia di sistema tracciata."

#. module: crm_methodology
#: model:ir.model.fields,help:crm_methodology.field_crm_lead__trial_expiry_date
msgid ""
"The date Auto-Destroy fires for this opportunity's Trial Org, absent a "
"further Extension. Rendered in the viewing user's own date format/timezone "
"by the Date widget, same as any other date field."
msgstr ""
"La data in cui scatta l'Auto-Destroy per il Trial Org di questa opportunità,"
" salvo un'ulteriore Extension. Visualizzata nel formato data/fuso orario "
"dell'utente che la visualizza, tramite il widget Data, come qualsiasi altro "
"campo data."

#. module: crm_methodology
#: model:ir.model.fields,help:crm_methodology.field_crm_methodology_trial_issue_wizard__prospect_domain
msgid ""
"The prospect's expected email domain. Locked on the Trial Org once issued."
msgstr ""
"Il dominio e-mail atteso del prospect. Bloccato sul Trial Org una volta "
"emesso."

#. module: crm_methodology
#: model:ir.model.fields,help:crm_methodology.field_crm_lead__trial_expiry_countdown
msgid ""
"Time remaining until Auto-Destroy, computed against the viewing user's own "
"timezone - not stored, so it reflects 'now' the moment this record is read."
msgstr ""
"Tempo rimanente prima dell'Auto-Destroy, calcolato in base al fuso orario "
"dell'utente che visualizza - non memorizzato, quindi riflette il momento "
"'ora' in cui questo record viene letto."

#. module: crm_methodology
#: model_terms:ir.ui.view,arch_db:crm_methodology.crm_lead_view_form_methodology
msgid "Trial"
msgstr "Prova"

#. module: crm_methodology
#: model:ir.model.fields,field_description:crm_methodology.field_crm_lead__trial_expiry_date
#: model:ir.model.fields,field_description:crm_methodology.field_crm_lead__trial_expiry_display
#: model_terms:ir.ui.view,arch_db:crm_methodology.crm_lead_view_form_methodology
msgid "Trial Expiry"
msgstr "Scadenza della prova"

#. module: crm_methodology
#: model:ir.model.fields,field_description:crm_methodology.field_crm_lead__trial_expiry_countdown
msgid "Trial Expiry Countdown"
msgstr "Conto alla rovescia della scadenza della prova"

#. module: crm_methodology
#: model:ir.model.fields,field_description:crm_methodology.field_crm_lead__trial_org_id
msgid "Trial Org"
msgstr "Trial Org"

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org extended by %(days)s days, new expiry %(expiry)s."
msgstr "Trial Org esteso di %(days)s giorni, nuova scadenza %(expiry)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via a Targeted Invite to %(email)s."
msgstr "Trial Org emesso tramite un Invito Mirato a %(email)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "Trial Org issued via an Open Invite Link for %(domain)s."
msgstr "Trial Org emesso tramite un Link di Invito Aperto per %(domain)s."

#. module: crm_methodology
#. odoo-python
#: code:addons/crm_methodology/models/crm_lead.py:0
msgid "expired"
msgstr "scaduto"

#. module: crm_methodology
#: model_terms:ir.ui.view,arch_db:crm_methodology.crm_methodology_trial_extend_wizard_view_form
#: model_terms:ir.ui.view,arch_db:crm_methodology.crm_methodology_trial_issue_wizard_view_form
msgid "Cancel"
msgstr "Annulla"
