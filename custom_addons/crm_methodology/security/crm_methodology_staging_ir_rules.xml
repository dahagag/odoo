<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- "Linked-to-me" portal visibility (addons/sale/security/ir_rules.xml's own
         sale_order_rule_portal domain_force, reused verbatim), scoped to
         group_staging_early_adopter specifically - not base.group_portal - so this grant never
         reaches any other portal user elsewhere in this instance, only the dedicated early-
         adopter group (docs/adr/0041). perm_create is True here, unlike stock sale's own portal
         rule (perm_create=False): a sales-methodology product is evaluated by running a deal
         through it, not by spectating someone else's pre-seeded data, so adopters need to be able
         to create their own test opportunities too, not just edit seeded ones. Staff
         (sales_team.group_sale_salesman/manager) carry no rule referencing this group, so their
         own full cross-adopter visibility is untouched. -->
    <record id="crm_lead_rule_staging_early_adopter" model="ir.rule">
        <field name="name">Early Adopter Personal Opportunities</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[('partner_id','child_of',[user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_staging_early_adopter'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
