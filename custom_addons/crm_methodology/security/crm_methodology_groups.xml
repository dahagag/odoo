<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_crm_methodology" model="ir.module.category">
        <field name="name">Sales Methodology</field>
    </record>

    <record id="privilege_crm_methodology_viewer" model="res.groups.privilege">
        <field name="name">Sales Methodology Viewer</field>
        <field name="category_id" ref="module_category_crm_methodology"/>
    </record>

    <!-- Broad, read-only visibility across CRM/Sales so a Viewer can browse an opportunity
         and follow it to its linked quotation, contact, etc. without hitting access-denied
         walls. Only implies base.group_user (required to log in to the backend at all) -
         deliberately not any sales_team group, since those also grant write/create. -->
    <record id="crm_methodology_group_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_crm_methodology_viewer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read-only access to CRM opportunities, quotations, contacts, sales teams, stages, products, and this module's own methodology data (the last three via read rows granted directly to internal users; the rest via new rows scoped to this group). Cannot create, edit, or delete anything, anywhere.</field>
    </record>

    <!-- Model-level ACL alone isn't enough: the CRM app's own root menu is gated to
         sales_team.group_sale_salesman/group_sale_manager, so without this the Viewer would
         have read access to crm.lead but no way to reach it through the UI at all. Its "My
         Pipeline" and "Customers" submenus carry no group of their own, so they inherit
         visibility from this and become reachable too. -->
    <record id="crm.crm_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('crm_methodology_group_viewer'))]"/>
    </record>

</odoo>
