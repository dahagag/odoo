<odoo>
    <record id="view_example_announcement_list" model="ir.ui.view">
        <field name="name">example.announcement.list</field>
        <field name="model">example.announcement</field>
        <field name="arch" type="xml">
            <list string="Announcements">
                <field name="name"/>
                <field name="author_id"/>
                <field name="expires_on"/>
                <field name="is_expired" decoration-danger="is_expired"/>
            </list>
        </field>
    </record>

    <record id="view_example_announcement_form" model="ir.ui.view">
        <field name="name">example.announcement.form</field>
        <field name="model">example.announcement</field>
        <field name="arch" type="xml">
            <form string="Announcement">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author_id"/>
                        <field name="expires_on"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_example_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">example.announcement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
