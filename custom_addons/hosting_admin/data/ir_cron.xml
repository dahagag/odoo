<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Light periodic sync (docs/adr/0034, this ticket's Implementation Decisions):
             mirrored state is "refreshed on read and by a light periodic sync" - the stack
             itself is now the sole authority on idle-suspend, auto-destroy, and job status, so
             this only refreshes what Odoo caches for display, never decides a transition. -->
        <record id="ir_cron_hosting_trial_org_sync_from_stack" model="ir.cron">
            <field name="name">Hosting: Sync Trial Org state from the administration stack</field>
            <field name="model_id" ref="model_hosting_trial_org"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_from_stack()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
