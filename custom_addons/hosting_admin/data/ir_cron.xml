<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Idle-timeout Suspend (docs/adr/0014): active -> suspended after ~30 min with no
             recorded activity. Never wakes anything itself - only action_wake() does that. -->
        <record id="ir_cron_hosting_trial_org_suspend_idle" model="ir.cron">
            <field name="name">Hosting: Suspend idle Trial Orgs</field>
            <field name="model_id" ref="model_hosting_trial_org"/>
            <field name="state">code</field>
            <field name="code">model._cron_suspend_idle()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Expiry-triggered Auto-Destroy (docs/contexts/hosting/CONTEXT.md's Auto-Destroy
             entry): active/suspended -> destroyed once expiry_date has passed. Manual teardown
             goes through action_destroy() directly and shares the same snapshot-marker logic. -->
        <record id="ir_cron_hosting_trial_org_auto_destroy_expired" model="ir.cron">
            <field name="name">Hosting: Auto-Destroy expired Trial Orgs</field>
            <field name="model_id" ref="model_hosting_trial_org"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_destroy_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
