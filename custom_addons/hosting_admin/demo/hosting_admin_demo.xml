<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================
         One cumulative demo story for hosting_admin (docs/agents/odoo-19-development.md's
         Post-implementation walkthrough section): every ticket touching this addon extends this
         file rather than adding its own. First populated here (#115, the Cost Dashboard) - three
         Trial Orgs reusing crm_methodology's own demo companies (Nimbus Robotics, Falcon
         Logistics, Comet Analytics), so a stakeholder walkthrough can tell one continuous story
         across both addons: an Opportunity issues a Trial Org.

         #197 shrinks this story to what a CRM-facing rep integration actually shows: the Cost
         Dashboard (an AWS-only concern, docs/adr/0034) moved out with the rest of the ported
         lifecycle, and every Trial Org's mirrored fields (state, seats_used, dns_subdomain_label,
         expiry_date, ...) now come back from StubHostingStackClient - the same no-network stand-in
         the test suite exercises - rather than being assigned directly, since this addon no
         longer owns any of them. Lifecycle actions still go through action_issue()/
         action_suspend() (models/trial_org.py), which now call through to that stub instead of a
         local state machine.
         ============================================================ -->

    <!-- Platform-only data (docs/adr/0018): base.user_admin needs an explicit grant into
         group_hosting_admin_administrator to see any of this at all, same as any other
         Platform operator - `Command.link` adds it alongside the admin's existing groups
         rather than replacing them. -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[Command.link(ref('hosting_admin.group_hosting_admin_administrator'))]"/>
    </record>

    <!-- #174: "localhost" so the asleep/Wake-Up page (controllers/asleep.py, models/ir_http.py)
         is actually explorable in a local walkthrough - real browsers resolve any
         "*.localhost" host to loopback on their own (RFC 6761), so
         http://<label>.localhost:8069/ reaches this same dev stack with no hosts-file edit
         needed, landing on the asleep page for whichever demo Trial Org below is suspended. -->
    <record id="hosting_admin_demo_config_dns_domain_suffix" model="ir.config_parameter">
        <field name="key">hosting_admin.dns_domain_suffix</field>
        <field name="value">localhost</field>
    </record>

    <!-- ================= Trial Orgs (issued from crm_methodology's own demo Opportunities) ================= -->

    <record id="hosting_admin_demo_trial_org_nimbus" model="hosting.trial.org">
        <field name="name">Nimbus Robotics Trial</field>
        <field name="prospect_domain">nimbus-robotics.example</field>
        <field name="seat_cap">8</field>
    </record>
    <function model="hosting.trial.org" name="action_issue"
              eval="[[ref('hosting_admin_demo_trial_org_nimbus')]]"/>

    <!-- Suspended: the idle-timeout Suspend (docs/adr/0014, now enforced by the stack) has since
         kicked in - the "non-default state" edge case the walkthrough doc's demo-seeding
         guidance asks for. -->
    <record id="hosting_admin_demo_trial_org_falcon" model="hosting.trial.org">
        <field name="name">Falcon Logistics Trial</field>
        <field name="prospect_domain">falcon-logistics.example</field>
        <field name="seat_cap">5</field>
    </record>
    <function model="hosting.trial.org" name="action_issue"
              eval="[[ref('hosting_admin_demo_trial_org_falcon')]]"/>
    <function model="hosting.trial.org" name="action_suspend"
              eval="[[ref('hosting_admin_demo_trial_org_falcon')]]"/>

    <record id="hosting_admin_demo_trial_org_comet" model="hosting.trial.org">
        <field name="name">Comet Analytics Trial</field>
        <field name="prospect_domain">comet-analytics.example</field>
        <field name="seat_cap">3</field>
    </record>
    <function model="hosting.trial.org" name="action_issue"
              eval="[[ref('hosting_admin_demo_trial_org_comet')]]"/>

</odoo>
