<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hosting_trial_org_list" model="ir.ui.view">
        <field name="name">hosting.trial.org.list</field>
        <field name="model">hosting.trial.org</field>
        <field name="arch" type="xml">
            <list string="Trial Orgs">
                <field name="name"/>
                <field name="prospect_domain"/>
                <field name="state"/>
                <field name="seat_cap"/>
                <field name="expiry_date"/>
                <field name="last_job_status"/>
            </list>
        </field>
    </record>

    <record id="view_hosting_trial_org_form" model="ir.ui.view">
        <field name="name">hosting.trial.org.form</field>
        <field name="model">hosting.trial.org</field>
        <field name="arch" type="xml">
            <form string="Trial Org">
                <sheet>
                    <!-- Odoo 19 requires a field referenced by any invisible= expression below
                         to be present in the view's own field list, even hidden. -->
                    <field name="audit_trail_available" invisible="1"/>
                    <field name="audit_trail_steps_available" invisible="1"/>
                    <widget name="web_ribbon" title="Destroyed" bg_color="text-bg-danger" invisible="state != 'destroyed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="issued,active,suspended,destroyed"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="prospect_domain"/>
                            <field name="seat_cap"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="last_job_action"/>
                            <field name="last_job_status"/>
                            <field name="last_job_started_at"/>
                            <field name="last_job_error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lifecycle Audit Trail">
                            <!-- docs/adr/0022: read live from AWS every time this record is
                                 opened, never cached or persisted in Odoo - see
                                 hosting.trial.org._compute_audit_trail(). -->
                            <div class="alert alert-info" role="alert"
                                 invisible="audit_trail_available">
                                No audit trail is available for this Trial Org yet (it has not
                                run a lifecycle action) or AWS could not be reached just now.
                            </div>
                            <group invisible="not audit_trail_available">
                                <field name="audit_trail_action"/>
                                <field name="audit_trail_status"/>
                                <field name="audit_trail_started_at"/>
                                <field name="audit_trail_stopped_at"/>
                            </group>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not audit_trail_available or audit_trail_steps_available">
                                Step-by-step detail could not be retrieved for this execution;
                                the overall status/timing above is still current.
                                <field name="audit_trail_steps_unavailable_reason"
                                       invisible="not audit_trail_steps_unavailable_reason"
                                       class="fw-bold" nolabel="1"/>
                            </div>
                            <field name="audit_trail_steps" widget="text" readonly="1"
                                   invisible="not audit_trail_steps_available"
                                   nolabel="1"/>
                        </page>
                        <!-- docs/adr/0023: live-tailing, filterable-by-user log viewer, fed by
                             the log webhook controller's bus.bus publications - never polling.
                             Only meaningful once this record is saved (it subscribes to a
                             channel keyed on its own id), so it is hidden until then. -->
                        <page string="Live Log" invisible="not id">
                            <widget name="hosting_trial_org_log_viewer"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hosting_trial_org" model="ir.actions.act_window">
        <field name="name">Trial Orgs</field>
        <field name="res_model">hosting.trial.org</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
