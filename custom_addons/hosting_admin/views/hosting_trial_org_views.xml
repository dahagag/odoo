<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hosting_trial_org_list" model="ir.ui.view">
        <field name="name">hosting.trial.org.list</field>
        <field name="model">hosting.trial.org</field>
        <field name="arch" type="xml">
            <list string="Trial Orgs">
                <field name="name"/>
                <field name="prospect_domain"/>
                <field name="invite_type"/>
                <field name="state"/>
                <field name="seats_used"/>
                <field name="seat_cap"/>
                <field name="expiry_date"/>
                <field name="last_job_status"/>
            </list>
        </field>
    </record>

    <record id="view_hosting_trial_org_form" model="ir.ui.view">
        <field name="name">hosting.trial.org.form</field>
        <field name="model">hosting.trial.org</field>
        <field name="arch" type="xml">
            <form string="Trial Org">
                <header>
                    <!-- This addon keeps only mirrored read-only state and the Issue/Extension
                         actions (this ticket's Implementation Decisions) - Extension itself is
                         issued from the Opportunity (crm_methodology's own wizard), never from
                         here, since ADR-0034's authorisation gate (sales-methodology
                         qualification) lives entirely on that side. Suspend/Wake/Destroy remain
                         callable methods (action_wake() is what controllers/asleep.py's own Wake
                         Up button drives), but deliberately have no button here - a staff
                         operator's actual admin surface is the stack's own future staff app
                         (#199), not this addon. -->
                    <button name="action_sync_from_stack" type="object" string="Refresh from Stack"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Destroyed" bg_color="text-bg-danger" invisible="state != 'destroyed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="issued,active,suspended,destroyed"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="prospect_domain"/>
                            <field name="dns_subdomain_label"/>
                            <field name="invite_type"/>
                            <field name="seat_cap"/>
                            <field name="seats_used"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="last_job_action"/>
                            <field name="last_job_status"/>
                            <field name="last_job_started_at"/>
                            <field name="last_job_error"/>
                            <field name="last_activity_at"/>
                            <field name="snapshot_retention_until"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Every field above is mirrored from the administration stack (docs/adr/
                        0034) - Odoo never decides this Trial Org's lifecycle. Use "Refresh from
                        Stack" for the current state; a light periodic sync also keeps it current.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hosting_trial_org" model="ir.actions.act_window">
        <field name="name">Trial Orgs</field>
        <field name="res_model">hosting.trial.org</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
