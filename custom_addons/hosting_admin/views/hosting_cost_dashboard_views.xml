<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hosting_cost_dashboard_snapshot_form" model="ir.ui.view">
        <field name="name">hosting.cost.dashboard.snapshot.form</field>
        <field name="model">hosting.cost.dashboard.snapshot</field>
        <field name="arch" type="xml">
            <form string="Cost Dashboard" create="false" delete="false">
                <header>
                    <button name="action_refresh_now" type="object" string="Refresh Now"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <!-- Odoo 19 requires a field referenced by any invisible= expression below
                         to be present in the view's own field list, even hidden. -->
                    <field name="days_remaining_on_credit_known" invisible="1"/>
                    <!-- docs/adr/0030 and the ticket's own acceptance criterion: figures are a
                         daily-refresh snapshot, not a live AWS read, and can lag up to 24h
                         behind actual spend (Cost Explorer's own tag-activation delay,
                         docs/research/aws-hosting-foundation-tooling.md). -->
                    <div class="alert alert-warning" role="alert">
                        Figures may lag up to 24 hours behind actual AWS spend. AWS cost
                        allocation tags take up to a day to become queryable in Cost Explorer,
                        so these numbers reflect what AWS had indexed as of this snapshot's own
                        refresh, not real-time usage.
                    </div>
                    <h1>
                        AWS Cost Dashboard
                        <span class="text-muted" style="font-size: 14px; font-weight: 400;">
                            (<field name="snapshot_date" nolabel="1"/>)
                        </span>
                    </h1>
                    <!-- KPI row matching the agreed design-board layout (docs/design/
                         115-cost-dashboard/README.md): three bordered cards, the credit one
                         accented to match the addon's brand color. -->
                    <div class="d-flex" style="gap: 16px; margin-bottom: 16px;">
                        <div class="flex-grow-1" style="border: 1px solid #dee2e6; border-radius: 4px; padding: 20px;">
                            <div class="text-muted" style="font-size: 12px; text-transform: uppercase; letter-spacing: .03em;">
                                Total Spend
                            </div>
                            <div style="font-size: 28px; font-weight: 500;">
                                $<field name="total_spend" nolabel="1"/>
                            </div>
                            <div class="text-muted" style="font-size: 12px;">
                                across <field name="trial_org_count" nolabel="1"/> Trial Org<span invisible="trial_org_count == 1">s</span>
                            </div>
                        </div>
                        <div class="flex-grow-1" style="border: 1px solid #dee2e6; border-radius: 4px; padding: 20px;">
                            <div class="text-muted" style="font-size: 12px; text-transform: uppercase; letter-spacing: .03em;">
                                Burn Rate
                            </div>
                            <div style="font-size: 28px; font-weight: 500;">
                                $<field name="burn_rate_per_day" nolabel="1"/><span style="font-size: 14px; font-weight: 400;">/day</span>
                            </div>
                            <div class="text-muted" style="font-size: 12px;">
                                avg. of last 7 days
                            </div>
                        </div>
                        <div class="flex-grow-1" style="border: 1px solid #71639e; border-radius: 4px; padding: 20px; background: #f6f4fa;">
                            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: .03em; color: #63578a;">
                                Days Remaining on Credit
                            </div>
                            <div style="font-size: 28px; font-weight: 500; color: #4d4370;"
                                 invisible="not days_remaining_on_credit_known">
                                <field name="days_remaining_on_credit" nolabel="1"/>
                            </div>
                            <div style="font-size: 14px; color: #4d4370;" invisible="days_remaining_on_credit_known">
                                Not yet available (no spend recorded)
                            </div>
                            <div style="font-size: 12px; color: #63578a;">
                                $<field name="credit_remaining" nolabel="1"/> left of $<field name="credit_amount" nolabel="1"/>
                            </div>
                        </div>
                    </div>
                    <field name="line_ids" string="Spend by Trial Org">
                        <list create="false" delete="false">
                            <field name="org_label" string="Trial Org"/>
                            <field name="spend_share_pct" widget="progressbar" string="Share of Spend"/>
                            <field name="spend"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hosting_cost_dashboard" model="ir.actions.server">
        <field name="name">Cost Dashboard</field>
        <field name="model_id" ref="model_hosting_cost_dashboard_snapshot"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

</odoo>
