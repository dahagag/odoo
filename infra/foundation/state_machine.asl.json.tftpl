{
  "Comment": "Trial Org lifecycle (Issue/Extend/Suspend/Wake/Auto-Destroy) - ADR-0016/0019/0020/0021. StartExecution's own execution name is set by the CALLER (hosting_admin), not by this definition or auto-generated by AWS - the Step Functions API gives a state machine no way to name its own execution. hosting_admin MUST derive it as trial-<trial_org_id>-<job_id> per ADR-0019, since the AcquireLock/lock_acquire Lambda's owner-token release logic and the hosting_admin IAM role's execution-ARN scoping (foundation/iam.tf) both assume that exact naming convention holds.",
  "StartAt": "AcquireLock",
  "States": {
    "AcquireLock": {
      "Comment": "Conditional PutItem via a Lambda (lambda_src/lock_acquire) rather than the native arn:aws:states:::dynamodb:putItem integration: acquisition also computes the TTL backstop's expiry as Unix-epoch seconds, and the Amazon States Language has no intrinsic function to convert $$.State.EnteredTime's ISO8601 string into epoch arithmetic. ReleaseLock/ReleaseLockOnFailure below need no such arithmetic, so they use the native dynamodb:deleteItem integration directly.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lock_acquire_lambda_arn}",
        "Payload": {
          "trial_org_id.$": "$.trial_org_id",
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "ResultPath": "$.lock_result",
      "TimeoutSeconds": ${lambda_invoke_timeout_seconds},
      "Retry": [
        {
          "ErrorEquals": ["RuntimeError"],
          "MaxAttempts": ${lock_retry_max_attempts},
          "BackoffRate": ${retry_backoff_rate},
          "IntervalSeconds": ${lock_retry_interval_seconds}
        },
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": ${retry_max_attempts},
          "BackoffRate": ${retry_backoff_rate},
          "IntervalSeconds": ${retry_interval_seconds}
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "LockNotAcquired"
        }
      ],
      "Next": "RouteAction"
    },

    "LockNotAcquired": {
      "Type": "Fail",
      "Error": "TrialOrgLockNotAcquired",
      "Cause": "Could not acquire the per-Trial-Org lifecycle lock; another action is in progress or the lock is stale."
    },

    "RouteAction": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.action",
          "StringEquals": "suspend",
          "Next": "SuspendInstance"
        },
        {
          "Variable": "$.action",
          "StringEquals": "wake",
          "Next": "WakeInstance"
        }
      ],
      "Default": "AssumeTrialOrgExecutionRole"
    },

    "AssumeTrialOrgExecutionRole": {
      "Comment": "Issue #125, ADR-0031: ecs:RunTask has no session-tag propagation mechanism equivalent to sts:AssumeRole's, so the shared ECS task role (foundation/iam.tf's now-empty ecs_task) can never itself be scoped to the one Trial Org an invocation targets. Assuming trial_org_execution here instead - tagging the session with this execution's own TrialOrgId and DnsRecordName - and handing RunTofu the resulting temporary credentials as container environment overrides gives `tofu apply` genuinely per-invocation-scoped EC2/DNS mutate permissions (trial_org_execution's own ABAC conditions key off these exact tags), with no change needed to the tofu-runner image itself: the AWS SDK/Terraform AWS provider credential chain prefers explicit AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN env vars over a container's own ECS task-role credentials.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sts:assumeRole",
      "Parameters": {
        "RoleArn": "${trial_org_execution_role_arn}",
        "RoleSessionName.$": "States.Format('trial-{}-{}', $.trial_org_id, $.job_id)",
        "Tags": [
          { "Key": "TrialOrgId", "Value.$": "$.trial_org_id" },
          { "Key": "DnsRecordName", "Value.$": "$.dns_record_name" }
        ]
      },
      "ResultPath": "$.assumed_role",
      "TimeoutSeconds": ${sts_assume_role_timeout_seconds},
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": ${retry_max_attempts},
          "BackoffRate": ${retry_backoff_rate},
          "IntervalSeconds": ${retry_interval_seconds}
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ReleaseLockOnFailure"
        }
      ],
      "Next": "RunTofu"
    },

    "SuspendInstance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ec2_power_control_lambda_arn}",
        "Payload": {
          "instance_id.$": "$.instance_id",
          "action": "stop"
        }
      },
      "ResultPath": "$.power_result",
      "TimeoutSeconds": ${ec2_power_timeout_seconds},
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": ${retry_max_attempts},
          "BackoffRate": ${retry_backoff_rate},
          "IntervalSeconds": ${retry_interval_seconds}
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ReleaseLockOnFailure"
        }
      ],
      "Next": "ReleaseLock"
    },

    "WakeInstance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ec2_power_control_lambda_arn}",
        "Payload": {
          "instance_id.$": "$.instance_id",
          "action": "start"
        }
      },
      "ResultPath": "$.power_result",
      "TimeoutSeconds": ${ec2_power_timeout_seconds},
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": ${retry_max_attempts},
          "BackoffRate": ${retry_backoff_rate},
          "IntervalSeconds": ${retry_interval_seconds}
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ReleaseLockOnFailure"
        }
      ],
      "Next": "ReleaseLock"
    },

    "RunTofu": {
      "Comment": "ClientToken folds in $$.State.RetryCount alongside $.job_id (ADR-0019's job identity) so a Step Functions-level Retry of this Task actually launches a fresh RunTask attempt instead of ECS's own ClientToken dedup handing back the already-failed original task. Within one attempt, repeated calls (e.g. the AWS SDK's own transport-level retries) still share one token, preserving the duplicate-launch protection ADR-0019 describes.",
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${ecs_cluster_arn}",
        "TaskDefinition": "${tofu_runner_task_definition_arn}",
        "LaunchType": "FARGATE",
        "ClientToken.$": "States.Format('{}-{}', $.job_id, $$.State.RetryCount)",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${private_subnet_ids_json},
            "SecurityGroups": ["${tofu_runner_security_group_id}"],
            "AssignPublicIp": "DISABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${tofu_runner_container_name}",
              "Environment": [
                { "Name": "TRIAL_ORG_ID", "Value.$": "$.trial_org_id" },
                { "Name": "JOB_ID", "Value.$": "$.job_id" },
                { "Name": "ACTION", "Value.$": "$.action" },
                { "Name": "AMI_ID", "Value.$": "$.ami_id" },
                { "Name": "MODULE_GIT_SHA", "Value.$": "$.module_git_sha" },
                { "Name": "AWS_ACCESS_KEY_ID", "Value.$": "$.assumed_role.Credentials.AccessKeyId" },
                { "Name": "AWS_SECRET_ACCESS_KEY", "Value.$": "$.assumed_role.Credentials.SecretAccessKey" },
                { "Name": "AWS_SESSION_TOKEN", "Value.$": "$.assumed_role.Credentials.SessionToken" }
              ]
            }
          ]
        }
      },
      "ResultPath": "$.tofu_result",
      "TimeoutSeconds": ${task_timeout_seconds},
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": ${retry_max_attempts},
          "BackoffRate": ${retry_backoff_rate},
          "IntervalSeconds": ${retry_interval_seconds}
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ReleaseLockOnFailure"
        }
      ],
      "Next": "ReleaseLock"
    },

    "ReleaseLock": {
      "Comment": "If this execution outlives the lock's TTL backstop (ADR-0020), DynamoDB's best-effort TTL sweep can delete the item before this runs, so the conditional delete fails with DynamoDB.ConditionalCheckFailedException. That's not a transient fault worth retrying (the condition will never start passing), and it means the lock is already gone either way, so it's treated as successful cleanup rather than an execution failure.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Parameters": {
        "TableName": "${lock_table_name}",
        "Key": {
          "trial_org_id": { "S.$": "$.trial_org_id" }
        },
        "ConditionExpression": "#owner = :execution_id",
        "ExpressionAttributeNames": {
          "#owner": "owner"
        },
        "ExpressionAttributeValues": {
          ":execution_id": { "S.$": "$$.Execution.Id" }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "MaxAttempts": 0
        },
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": ${retry_max_attempts},
          "BackoffRate": ${retry_backoff_rate},
          "IntervalSeconds": ${retry_interval_seconds}
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": null,
          "Next": "LockAlreadyReleased"
        }
      ],
      "End": true
    },

    "LockAlreadyReleased": {
      "Type": "Succeed",
      "Comment": "The lock item was already gone (TTL-expired and swept) by the time ReleaseLock ran; the lifecycle action itself already completed successfully."
    },

    "ReleaseLockOnFailure": {
      "Comment": "Same TTL-expiry race as ReleaseLock above, but on the failure path: the conditional delete's own DynamoDB.ConditionalCheckFailedException must not be retried (it won't start passing) or replace $.error (ResultPath null keeps it), so LifecycleActionFailed still reports the original failure.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Parameters": {
        "TableName": "${lock_table_name}",
        "Key": {
          "trial_org_id": { "S.$": "$.trial_org_id" }
        },
        "ConditionExpression": "#owner = :execution_id",
        "ExpressionAttributeNames": {
          "#owner": "owner"
        },
        "ExpressionAttributeValues": {
          ":execution_id": { "S.$": "$$.Execution.Id" }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "MaxAttempts": 0
        },
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": ${retry_max_attempts},
          "BackoffRate": ${retry_backoff_rate},
          "IntervalSeconds": ${retry_interval_seconds}
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": null,
          "Next": "LifecycleActionFailed"
        }
      ],
      "Next": "LifecycleActionFailed"
    },

    "LifecycleActionFailed": {
      "Type": "Fail",
      "Error": "TrialOrgLifecycleActionFailed",
      "Cause": "The Trial Org lifecycle action failed; the lock has been released."
    }
  }
}
