# Disposable local-development defaults. Copy to .env and keep that file private.
COMPOSE_PROJECT_NAME=agentic-erp-dev
ODOO_IMAGE=odoo:19.0-20260817
# Leave unset for local dev: `scripts/dev.sh build` builds and tags this locally.
# CI overrides this to pull a prebuilt, cached image instead of rebuilding.
# ODOO_DEV_IMAGE=agentic-erp-dev-odoo:local
HOST_UID=1000
HOST_GID=1000
ODOO_DB=agentic_erp_dev
ODOO_TEST_DB_PREFIX=agentic_erp_test
ODOO_ADMIN_PASSWORD=change-me-local-only
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-local-only
ODOO_HTTP_PORT=8069
ODOO_GEVENT_PORT=8072
# qweb,xml is reliable on Docker Desktop. Native Linux users may opt into
# qweb,xml,reload after accepting the startup cost of watching all addon trees.
ODOO_DEV_MODE=qweb,xml
