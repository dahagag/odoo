{
  "openapi": "3.0.3",
  "info": {
    "title": "Administration Stack API",
    "version": "v1",
    "description": "Odoo/staff-app/client-app contract for the Trial Org and Client Org record of truth (docs/adr/0034, docs/adr/0036)."
  },
  "servers": [],
  "components": {
    "securitySchemes": {
      "orgToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque per-org token issued at provision time (docs/adr/0036). Scoped to exactly one org."
      },
      "sigv4": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "AWS SigV4 (docs/adr/0036), verified at the front door before the request reaches this service - not a literal API key. Modeled as apiKey here because OpenAPI 3.0 has no native SigV4 scheme."
      }
    },
    "schemas": {
      "OrgId": {
        "type": "string",
        "format": "uuid",
        "description": "The Administration Stack's own identifier for a Trial Org or Client Org."
      },
      "OrgType": {
        "type": "string",
        "enum": [
          "trial",
          "client"
        ],
        "description": "Trial Org: the ephemeral evaluation offering. Client Org: a stable hosted org for a paying client. See docs/contexts/hosting/CONTEXT.md."
      },
      "OrgState": {
        "type": "string",
        "enum": [
          "issued",
          "active",
          "suspended",
          "destroyed"
        ]
      },
      "OrgRegistration": {
        "type": "object",
        "properties": {
          "orgId": {
            "$ref": "#/components/schemas/OrgId"
          },
          "type": {
            "$ref": "#/components/schemas/OrgType"
          },
          "state": {
            "$ref": "#/components/schemas/OrgState"
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "seatsUsed": {
            "type": "integer",
            "minimum": 0
          },
          "seatsTotal": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "expiryDate": {
            "type": "string",
            "format": "date-time",
            "description": "Absent for a Client Org, which has no Auto-Destroy expiry."
          }
        },
        "required": [
          "orgId",
          "type",
          "state",
          "name",
          "domain",
          "seatsUsed",
          "seatsTotal"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Stack-specific machine-readable error code, stable across `detail` wording changes."
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "DnsSubdomainLabel": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
      },
      "OrgAction": {
        "type": "string",
        "enum": [
          "issue",
          "suspend",
          "wake",
          "destroy"
        ]
      },
      "Org": {
        "type": "object",
        "properties": {
          "orgId": {
            "$ref": "#/components/schemas/OrgId"
          },
          "type": {
            "$ref": "#/components/schemas/OrgType"
          },
          "state": {
            "$ref": "#/components/schemas/OrgState"
          },
          "region": {
            "type": "string"
          },
          "dnsSubdomainLabel": {
            "$ref": "#/components/schemas/DnsSubdomainLabel"
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "seatsUsed": {
            "type": "integer",
            "minimum": 0
          },
          "seatsTotal": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "opportunityId": {
            "type": "string"
          },
          "expiryDate": {
            "type": "string",
            "format": "date-time",
            "description": "Absent for a Client Org, which has no Auto-Destroy expiry."
          },
          "amiId": {
            "type": "string"
          },
          "tofuModuleGitSha": {
            "type": "string"
          },
          "pendingAmiId": {
            "type": "string"
          },
          "pendingTofuModuleGitSha": {
            "type": "string"
          },
          "lastJobId": {
            "type": "string"
          },
          "lastJobAction": {
            "$ref": "#/components/schemas/OrgAction"
          }
        },
        "required": [
          "orgId",
          "type",
          "state",
          "region",
          "dnsSubdomainLabel",
          "name",
          "domain",
          "seatsUsed",
          "seatsTotal"
        ]
      },
      "CreateOrgRequest": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/OrgType"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "seatsTotal": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "dnsSubdomainLabel": {
            "$ref": "#/components/schemas/DnsSubdomainLabel"
          },
          "opportunityId": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "description": "Defaults to the stack's configured region when omitted (per-org region selection is #207, deferred)."
          }
        },
        "required": [
          "type",
          "name",
          "domain",
          "seatsTotal",
          "dnsSubdomainLabel"
        ]
      },
      "UpdateOrgRequest": {
        "type": "object",
        "properties": {
          "dnsSubdomainLabel": {
            "$ref": "#/components/schemas/DnsSubdomainLabel"
          }
        },
        "required": [
          "dnsSubdomainLabel"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not-ready"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/org/{orgId}/registration": {
      "get": {
        "summary": "Read an org's own Org Registration",
        "description": "docs/contexts/hosting/CONTEXT.md: \"the read-only summary of an org's own standing\". The org token must scope to {orgId} itself (docs/adr/0036) - any other {orgId} is 403.",
        "tags": [
          "org"
        ],
        "security": [
          {
            "orgToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/OrgId"
            },
            "required": true,
            "name": "orgId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgRegistration"
                }
              }
            }
          },
          "400": {
            "description": "Malformed orgId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid org token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Org token does not scope to this org",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such org",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/orgs/{orgId}": {
      "get": {
        "summary": "Read any Trial Org or Client Org record (staff plane)",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "sigv4": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/OrgId"
            },
            "required": true,
            "name": "orgId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgRegistration"
                }
              }
            }
          },
          "400": {
            "description": "Malformed orgId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing admin principal (SigV4 not verified at the front door)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such org",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Change dnsSubdomainLabel - only legal while the org is still `issued`",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "sigv4": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/OrgId"
            },
            "required": true,
            "name": "orgId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrgRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing admin principal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such org",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "dnsSubdomainLabel already in use, or the org has left `issued`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/orgs": {
      "post": {
        "summary": "Create a Trial Org or Client Org, starting in the `issued` state",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "sigv4": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrgRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing admin principal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "dnsSubdomainLabel already in use",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/orgs/{orgId}/issue": {
      "post": {
        "summary": "Lifecycle action: issue",
        "description": "Calls the configured provisioner (a no-op by default, #278) with a freshly minted job id (ADR-0019). Rejected from any source state the transition graph does not allow, leaving the record unchanged.",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "sigv4": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/OrgId"
            },
            "required": true,
            "name": "orgId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Org"
                }
              }
            }
          },
          "401": {
            "description": "Missing admin principal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such org",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Illegal transition, or a concurrent transition already won",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The provisioner failed; no state change was made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/orgs/{orgId}/suspend": {
      "post": {
        "summary": "Lifecycle action: suspend",
        "description": "Calls the configured provisioner (a no-op by default, #278) with a freshly minted job id (ADR-0019). Rejected from any source state the transition graph does not allow, leaving the record unchanged.",
