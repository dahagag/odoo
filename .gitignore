# sphinx build directories
_build/

# dotfiles
.*
!.env.example
!.gitattributes
!.gitignore
!.gitkeep
!.github
!.mailmap
!.weblate.json
!/stack/**/.dockerignore
# compiled python files
*.py[co]
__pycache__/
# setup.py egg_info
*.egg-info
# emacs backup files
*~
# hg stuff
*.orig
status
# odoo filestore
odoo/filestore
# maintenance migration scripts
odoo/addons/base/maintenance
# windows installation config file
/odoo.conf

# generated for windows installer?
install/win32/*.bat
install/win32/meta.py

# needed only when building for win32
setup/win32/static/less/
setup/win32/static/wkhtmltopdf/
setup/win32/static/postgresql*.exe

# js tooling
node_modules
jsconfig.json
tsconfig.json
package-lock.json
package.json
.husky
# stack/ (docs/adr/0034) is a real JS/TS monorepo, not Odoo's own OWL asset tooling the
# blanket ignores above exist for - its manifests are checked in like any other project's.
!/stack/**/package.json
!/stack/**/package-lock.json
!/stack/**/tsconfig.json
!/stack/**/jsconfig.json

# various virtualenv
/bin/
/build/
/dist/
/include/
/lib/
/man/
/share/
/src/

# expose .claude/skills to git
!.claude
.claude/*
!.claude/skills
